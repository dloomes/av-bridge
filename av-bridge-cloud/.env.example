# Cloud ingest service configuration (read from the environment).
# docker-compose.yml sets dev defaults; this documents the knobs.

CLOUD_LISTEN_ADDR=:8090

# Migration role: needs DDL privileges (CREATE TABLE/ROLE, ALTER TABLE ENABLE
# RLS, CREATE POLICY). Embedded migrations run on every cloud startup; a fresh
# volume gets the full schema, an existing volume is baselined and only new
# migrations apply. In dev that's the Postgres bootstrap superuser; in
# production scope this down to a one-shot migration role per environment.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/avbridge?sslmode=disable

# Two DB roles. app_admin has BYPASSRLS (auth lookup + bootstrap); app_tenant is
# RLS-enforced (all per-tenant data). See internal/db/migrations/0002_rls.sql.
DATABASE_ADMIN_URL=postgres://app_admin:app_admin_dev@localhost:5432/avbridge?sslmode=disable
DATABASE_TENANT_URL=postgres://app_tenant:app_tenant_dev@localhost:5432/avbridge?sslmode=disable

# 32-byte key as 64 hex chars. Encrypts per-collector HMAC secrets at rest.
# Generate: openssl rand -hex 32   (use KMS/Key Vault in production)
CLOUD_SECRET_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Bearer token gating /admin/* endpoints (collector registration etc.). When
# empty, admin endpoints are disabled. Replaced by proper Customer Admin auth
# once the portal lands.
ADMIN_API_TOKEN=dev-admin-token-change-me

# Slice 2 portal-read auth: one env-held token maps to the PoC customer.
# The web portal sends Authorization: Bearer <POC_PORTAL_TOKEN>. The
# customer_id it resolves to defaults to the PoC tenant. POC_PORTAL_ROLE
# controls what the dev token may do — "admin" enables placement + hierarchy
# CRUD; "viewer" is read-only.
POC_PORTAL_TOKEN=dev-portal-token-change-me
POC_PORTAL_CUSTOMER_ID=11111111-1111-1111-1111-111111111111
POC_PORTAL_ROLE=admin

# Optional PoC bootstrap: seed one tenant + collector on startup.
BOOTSTRAP_POC=true
POC_BRIDGE_COLLECTOR_ID=poc-collector-01
POC_HMAC_SECRET=poc-shared-secret

# Stale-claim sweeper (Slice 3.1). A command in_progress beyond COMMAND_STALE_AFTER
# is requeued to pending; after COMMAND_MAX_CLAIMS unsuccessful attempts it's
# failed with error 'bridge_timeout'. COMMAND_SWEEP_INTERVAL is the tick.
COMMAND_STALE_AFTER=5m
COMMAND_MAX_CLAIMS=3
COMMAND_SWEEP_INTERVAL=30s

# --- On the bridge side (av-bridge poc-config.yaml), to push here ---
#   cloud:
#     webhook_url: "http://<cloud-host>:8090/ingest"
#     hmac_secret: "poc-shared-secret"   # must match POC_HMAC_SECRET above
#     collector_id: "poc-collector-01"   # must match POC_BRIDGE_COLLECTOR_ID
