# Managed by Ansible — do not edit by hand
# Secrets for av-bridge on site {{ av_bridge_site_id }}
# File permissions: 640, owned root:av-bridge
# Populated from ansible-vault or your secrets manager

CLOUD_WEBHOOK_URL={{ av_bridge_cloud_webhook_url }}
CLOUD_API_KEY={{ av_bridge_cloud_api_key | default('') }}
LOCAL_API_KEY={{ av_bridge_local_api_key | default('') }}
HMAC_SECRET={{ av_bridge_hmac_secret | default('') }}

{% if av_bridge_devices is defined %}
{% for device in av_bridge_devices %}
{% if device.password is defined %}
DEVICE_{{ device.id | upper | replace('-', '_') }}_PASSWORD={{ device.password }}
{% endif %}
{% endfor %}
{% endif %}
