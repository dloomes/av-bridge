# Copy to terraform.tfvars (git-ignored) and fill in. This file holds no
# secrets: the GitHub PAT and the Entra client secret live in Secrets Manager
# (avrmm-prod/github-token, avrmm-prod/entra-vendor-client-secret - created
# by hand, see the runbook), and the vendor admin password is generated by
# terraform into Secrets Manager.

# First-boot vendor (helpdesk) admin, seeded only when no vendor user exists.
vendor_admin_email = "<vendor-admin-email>"
vendor_admin_name  = "<vendor-admin-name>"

# Entra vendor SSO app registration ids (not secret).
entra_vendor_tenant_id = "<entra-tenant-guid>"
entra_vendor_client_id = "<entra-client-id>"

# Optional
dmarc_rua           = "<dmarc-report-address>"
mapbox_public_token = "<mapbox-public-token>"

# Production alarm emails (confirm the SNS subscription email after apply).
alert_email = "<alert-email>"
