{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping av-bridge /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "av-bridge fleet health — device status across all sites",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total devices",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "mappings": [],
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(av_bridge_devices_total)",
        "legendFormat": "Total",
        "refId": "A"
      }]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(av_bridge_devices_online)",
        "legendFormat": "Online",
        "refId": "A"
      }]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Offline",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]},
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(av_bridge_devices_offline)",
        "legendFormat": "Offline",
        "refId": "A"
      }]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Degraded",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 }
          ]},
          "unit": "short",
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(av_bridge_devices_degraded)",
        "legendFormat": "Degraded",
        "refId": "A"
      }]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Fleet availability",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 80 },
            { "color": "green", "value": 95 }
          ]},
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "decimals": 1
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "100 * sum(av_bridge_devices_online) / sum(av_bridge_devices_total)",
        "legendFormat": "Availability %",
        "refId": "A"
      }]
    },

    {
      "id": 6,
      "type": "piechart",
      "title": "Device status breakdown",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Online" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Offline" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Degraded" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(av_bridge_devices_online)", "legendFormat": "Online", "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(av_bridge_devices_offline)", "legendFormat": "Offline", "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(av_bridge_devices_degraded)", "legendFormat": "Degraded", "refId": "C"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Device availability over time",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 4 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Online" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Offline" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Degraded" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(av_bridge_devices_online)",
          "legendFormat": "Online", "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(av_bridge_devices_offline)",
          "legendFormat": "Offline", "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(av_bridge_devices_degraded)",
          "legendFormat": "Degraded", "refId": "C"
        }
      ]
    },

    {
      "id": 8,
      "type": "table",
      "title": "All devices — current status",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "options": {
        "sortBy": [{ "displayName": "Status", "desc": false }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [{
              "id": "mappings",
              "value": [
                { "type": "value", "options": { "1": { "text": "Online",   "color": "green"  } } },
                { "type": "value", "options": { "2": { "text": "Degraded", "color": "orange" } } },
                { "type": "value", "options": { "3": { "text": "Offline",  "color": "red"    } } },
                { "type": "value", "options": { "0": { "text": "Unknown",  "color": "gray"   } } }
              ]
            }, {
              "id": "custom.displayMode", "value": "color-background"
            }]
          },
          {
            "matcher": { "id": "byName", "options": "Online" },
            "properties": [{
              "id": "mappings",
              "value": [
                { "type": "value", "options": { "1": { "text": "Yes", "color": "green" } } },
                { "type": "value", "options": { "0": { "text": "No",  "color": "red"   } } }
              ]
            }, { "id": "custom.displayMode", "value": "color-background" }]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "id": "Device ID",
              "name": "Device name",
              "type": "Type",
              "location": "Location",
              "Value #Status": "Status",
              "Value #Online": "Online"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "av_bridge_device_status",
          "legendFormat": "{{id}} | {{name}} | {{type}}",
          "instant": true,
          "format": "table",
          "refId": "Status"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "av_bridge_device_online",
          "legendFormat": "{{id}}",
          "instant": true,
          "format": "table",
          "refId": "Online"
        }
      ]
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Per-device status history",
      "description": "1 = online, 2 = degraded, 3 = offline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "calcs": ["last"] },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 3,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "spanNulls": false }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "av_bridge_device_status{type=~\"$device_type\"}",
        "legendFormat": "{{name}} ({{location}})",
        "refId": "A"
      }]
    }

  ],

  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["av-bridge", "av", "iot", "fleet"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(av_bridge_device_status, type)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "device_type",
        "options": [],
        "query": {
          "query": "label_values(av_bridge_device_status, type)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "label": "Device type",
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(av_bridge_device_status, location)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "location",
        "options": [],
        "query": {
          "query": "label_values(av_bridge_device_status, location)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "label": "Location",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AV Bridge — Fleet Health",
  "uid": "av-bridge-fleet",
  "version": 1
}
